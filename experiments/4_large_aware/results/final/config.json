{
  "model": {
    "encoder_name": "microsoft/deberta-v3-large",
    "encoder_path": "results/dapt_large/encoder",
    "hidden_size": 1024,
    "lstm_hidden": 256,
    "lstm_layers": 2,
    "max_sentences": 32,
    "max_seq_length": 512,
    "num_labels": 8,
    "dropout": 0.3,
    "use_bilstm": true,
    "bilstm_dropout": 0.25,
    "use_position_embedding": true,
    "use_prototype_head": false,
    "n_dropout_samples": 3,
    "context_type": "gated_attention",
    "context_num_heads": 4,
    "gate_init_bias": -2.0,
    "pooling_type": "attention"
  },
  "loss": {
    "loss_type": "asl",
    "asl_gamma_pos": 0.0,
    "asl_gamma_neg": 2.5,
    "asl_clip": 0.03,
    "label_smoothing": 0.02,
    "theme_weights": null,
    "use_cb_weights": true
  },
  "training": {
    "phase1_epochs": 8,
    "phase2_epochs": 40,
    "batch_size": 4,
    "gradient_accumulation": 8,
    "encoder_lr": 5e-06,
    "decoder_lr": 2e-05,
    "phase2_encoder_lr_scale": 1.0,
    "weight_decay": 0.08,
    "max_grad_norm": 1.0,
    "warmup_ratio": 0.1,
    "early_stopping_patience": 8,
    "phase2_early_stopping_patience": 8,
    "fp16": true,
    "num_workers": 4,
    "rdrop_alpha": 1.0,
    "phase3_epochs": 5,
    "phase3_lr": 5e-06,
    "phase3_patience": 3,
    "adam_beta2": 0.999,
    "gradient_checkpointing": false,
    "use_llrd": true,
    "llrd_decay": 0.92,
    "essay_aux_weight": 0.15,
    "phase1_lr": 0.0001,
    "phase1_rdrop": 0.0,
    "swa_start_ratio": 0.25,
    "progressive_unfreeze": true,
    "progressive_unfreeze_layers": 12,
    "progressive_unfreeze_after": 6,
    "phase3_unfreeze_bilstm": true,
    "context_dropout": 0.15
  },
  "augmentation": {
    "enabled": true,
    "aeda_prob": 0.4
  },
  "dapt": {
    "mlm_probability": 0.15,
    "epochs": 15,
    "batch_size": 8,
    "learning_rate": 2e-05,
    "warmup_ratio": 0.06,
    "fp16": true,
    "eval_split": 0.1,
    "weight_decay": 0.01
  },
  "seed": 42,
  "mode": "full"
}